# Skopiuj do .env i uzupełnij. Nigdy nie commituj .env.
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
# ID kanału: @nazwa_kanalu albo -100xxxxxxxxxx (bot musi być adminem kanału)
TELEGRAM_CHANNEL_ID=
# Kanał testowy – używany, gdy publish.use_test_channel: true w settings.yaml
TELEGRAM_TEST_CHANNEL_ID=
# Prywatny czat admina na alerty i raport dzienny (najpierw wyślij botowi /start); puste = tylko logi
TELEGRAM_ADMIN_CHAT_ID=
